flowchart LR
    A["DoMagic"] --> B["Encrypted payload embedded<br/>IV + CIPHERTEXT"]
    B --> C["Allocate RW buffer<br/>VirtualAlloc"]
    C --> D["Copy CIPHERTEXT into buffer<br/>memcpy"]
    D --> E["Acquire AES provider<br/>CryptAcquireContextA"]
    E --> F["Import AES-256 key<br/>CryptImportKey"]
    F --> G["Set CBC mode<br/>CryptSetKeyParam(KP_MODE)"]
    G --> H["Set IV<br/>CryptSetKeyParam(KP_IV)"]
    H --> I["Decrypt in place<br/>CryptDecrypt"]

    classDef decrypt fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#052e16;
    classDef data fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#422006;

    class A,C,D,E,F,G,H,I decrypt;
    class B data;
