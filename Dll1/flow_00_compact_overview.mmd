flowchart TD
    A["User launches<br/>host program"] --> B["Malicious DLL<br/>is loaded"]
    B --> C["DllMain<br/>runs"]
    C --> D["Set persistence<br/>Copy DLL + Startup VBS"]
    C --> E["Start payload<br/>worker thread"]
    E --> G["Decrypt embedded payload<br/>AES-256-CBC"]
    G --> H["Run shellcode<br/>in memory"]
    H --> I["Connect to C2"]
    I --> J["Cleanup memory<br/>SecureZeroMemory + VirtualFree"]
    D -. "Next user logon" .-> E

    classDef entry fill:#DBEAFE,stroke:#1D4ED8,stroke-width:4px,color:#172554,font-size:22px;
    classDef persist fill:#FEF3C7,stroke:#D97706,stroke-width:4px,color:#451A03,font-size:22px;
    classDef payload fill:#DCFCE7,stroke:#16A34A,stroke-width:4px,color:#052E16,font-size:22px;
    classDef execute fill:#FEE2E2,stroke:#DC2626,stroke-width:4px,color:#450A0A,font-size:22px;
    classDef c2 fill:#EDE9FE,stroke:#7C3AED,stroke-width:4px,color:#2E1065,font-size:22px;
    classDef cleanup fill:#E5E7EB,stroke:#4B5563,stroke-width:4px,color:#111827,font-size:22px;

    class A,B,C entry;
    class D persist;
    class E,G payload;
    class H execute;
    class I c2;
    class J cleanup;

    style A padding:18px
    style B padding:18px
    style C padding:18px
    style D padding:18px
    style E padding:18px
    style G padding:18px
    style H padding:18px
    style I padding:18px
